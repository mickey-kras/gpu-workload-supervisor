{
  "name": "Enforce work branch names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 29110,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [
        "refs/heads/main",
        "refs/heads/dependabot/*",
        "refs/heads/feat/*",
        "refs/heads/fix/*",
        "refs/heads/refactor/*",
        "refs/heads/docs/*",
        "refs/heads/ci/*",
        "refs/heads/security/*",
        "refs/heads/release/*"
      ],
      "include": [
        "~ALL"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
